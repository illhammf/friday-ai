{
  "name": "friday-ai",
  "version": "1.0.0",
  "description": "A personal AI assistant for WhatsApp, built with Node.js.",
  "private": true,
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test test/social-video.test.js test/video-download-failure.test.js test/conversation-style.test.js test/image-generation.test.js test/download-media.test.js test/voice-note-failure.test.js test/runtime-diagnostics.test.js"
  },
  "keywords": [
    "friday-ai",
    "whatsapp-bot",
    "personal-assistant",
    "artificial-intelligence",
    "nodejs",
    "wsl"
  ],
  "author": "Ilham Firmansyah",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/illhammf/friday-ai.git"
  },
  "bugs": {
    "url": "https://github.com/illhammf/friday-ai/issues"
  },
  "homepage": "https://github.com/illhammf/friday-ai#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
