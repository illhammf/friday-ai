
# AI provider configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Primary chat and image models. Model access and free quotas depend on your project.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated fallbacks, attempted in order only for quota/transient/model-not-found errors.
# List only models that your project can use; fallbacks are not automatically guaranteed free.
# GEMINI_FALLBACK_MODELS=
# Optional legacy single-model fallback (used after GEMINI_FALLBACK_MODELS).
# GEMINI_FALLBACK_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Separate image-generation fallbacks; each must support image output.
# GEMINI_IMAGE_FALLBACK_MODELS=

# Friday bot configuration
BOT_NAME=Friday
BOT_PREFIX=Friday
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional; defaults to a Linux Chrome browser user-agent for TikTok compatibility.
# YT_DLP_USER_AGENT=

# Runtime configuration
NODE_ENV=development
